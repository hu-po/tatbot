{
  "name": "@tatbot/inkmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tattoo mapping and preview on a 3D body \u2014 drag a design onto the surface, it snaps and stays.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "pretest": "node tools/prepare-showcase.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/run_sentence.mjs",
    "test:e2e:production": "node tests/e2e/run_sentence.mjs --production",
    "atlas:contact-sheet": "node --experimental-strip-types tools/atlas_contact_sheet.ts",
    "atlas:review-sheet": "node --experimental-strip-types tools/atlas_review_sheet.ts",
    "surface:parity": "node --experimental-strip-types tools/surface_parity.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run test:e2e:production"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "@xmldom/xmldom": "0.9.12",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
