# ~/tatbot-ros/env.sh on the arm node (written by `tatbot ros deploy`); sourced by both units and by
# every remote `tatbot ros` command. Lanes use the same file with their own domain and port.
source /opt/ros/jazzy/setup.bash
[ -f "@ROOT@/install/setup.bash" ] && source "@ROOT@/install/setup.bash"
export TATBOT_REPO="@ROOT@/repo"
export PYTHONPATH="$TATBOT_REPO/scripts/lib:$TATBOT_REPO/python/tatbot_contracts/src${PYTHONPATH:+:$PYTHONPATH}"
export RMW_IMPLEMENTATION=rmw_zenoh_cpp
export ROS_DOMAIN_ID=@DOMAIN@
export TATBOT_ROS_ROUTER="tcp/127.0.0.1:@PORT@"
# Explicit endpoints, multicast scouting off (rmw_zenoh's default, stated so it stays off): every
# session connects to this host's router only; the router unit swaps in its listen endpoint. The graph
# never leaves 127.0.0.1; the tatbot zenoh bus is a different network only tatbot_bridge joins.
export ZENOH_CONFIG_OVERRIDE="connect/endpoints=[\"$TATBOT_ROS_ROUTER\"];scouting/multicast/enabled=false"
export ZENOH_ROUTER_OVERRIDE="listen/endpoints=[\"$TATBOT_ROS_ROUTER\"];scouting/multicast/enabled=false"
