<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tatbot_motion</name>
  <version>0.1.0</version>
  <description>Program op -> timed Cartesian samples -> joint trajectory (CLIK on pinocchio). Pure Python, no ROS import.</description>
  <maintainer email="hello@tatbot.ai">hu-po</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>tatbot_description</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
