# Run logs and recordings live in ~/tatbot-logs/, never in the repo (AGENTS.md).
# These patterns are a backstop for a stray write, not the mechanism.
# Deliberately NOT *.csv: a future tracked data file would vanish silently.
*.log
*.wxtl
*.rrd
/tatbot-logs/
/.tatbot-deploy.json
/.tatbot-build.json
.claude/settings.local.json

# Compiled Inkmap showcase scenarios (~32 MB) from the deleted ManiSkill
# simulator. Nothing reads them any more and Vite would ship them from public/:
# delete any a checkout still has. Ignored so none is committed by accident.
web/inkmap/public/showcase/*.scenario.json
