{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/surface-placement.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "tattoo_program_sha256",
    "body_identity_sha256",
    "rest_surface_sha256",
    "semantic_site",
    "laterality",
    "anchor",
    "tangent_frame_rule",
    "physical_scale_m",
    "rotation_rad",
    "mirrored",
    "warp",
    "supported_domain",
    "review",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.surface-placement/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tattoo_program_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rest_surface_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_site": {
      "type": "string",
      "minLength": 1
    },
    "laterality": {
      "enum": [
        "left",
        "right",
        "midline",
        "not_applicable"
      ]
    },
    "anchor": {
      "$ref": "common.schema.json#/$defs/surfaceCoordinate"
    },
    "tangent_frame_rule": {
      "type": "string",
      "minLength": 1
    },
    "physical_scale_m": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "rotation_rad": {
      "type": "number"
    },
    "mirrored": {
      "type": "boolean"
    },
    "warp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "max_displacement_m",
            "parameters"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "max_displacement_m": {
              "type": "number",
              "minimum": 0
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 0
            }
          }
        }
      ]
    },
    "supported_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face_indices",
        "margin_m"
      ],
      "properties": {
        "face_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 36107
          },
          "minItems": 1
        },
        "margin_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "evidence_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
