{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/draw-samples-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "samples",
    "compiler",
    "inputs",
    "preflight",
    "sample_ranges",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.draw-samples-manifest/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "tatbot.draw-samples/1"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink_program_sha256",
        "body_state_sha256",
        "surface_registration_sha256",
        "measured_surface_sha256",
        "tool_datasheet_sha256",
        "robot_urdf_sha256",
        "support_configuration_sha256",
        "palette_snapshot_sha256",
        "palette_load_state_sha256",
        "calibration_sha256",
        "policy_sha256"
      ],
      "properties": {
        "ink_program_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "surface_registration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "measured_surface_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tool_datasheet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "robot_urdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "support_configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "palette_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "palette_load_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calibration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "motion_authorized",
        "observed_cells_only",
        "registration_sigma_m",
        "surface_sigma_m",
        "max_surface_age_s"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "motion_authorized": {
          "const": false
        },
        "observed_cells_only": {
          "const": true
        },
        "registration_sigma_m": {
          "type": "number",
          "minimum": 0
        },
        "surface_sigma_m": {
          "type": "number",
          "minimum": 0
        },
        "max_surface_age_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "sample_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ink_event_index",
          "kind",
          "start",
          "stop"
        ],
        "properties": {
          "ink_event_index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "stop": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minItems": 1
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
