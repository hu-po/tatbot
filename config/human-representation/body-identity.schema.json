{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/body-identity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "model_spec_sha256",
    "coefficients",
    "scales",
    "bounds_prior",
    "rest_surface_sha256",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.body-identity/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coefficients": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 45,
      "maxItems": 45
    },
    "scales": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 68,
      "maxItems": 68
    },
    "bounds_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "max_abs_coefficient",
        "max_abs_scale"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "max_abs_coefficient": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_abs_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rest_surface_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
