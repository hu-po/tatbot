{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/common.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "matrix4": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "version",
        "created_utc",
        "source_sha256"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "created_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surfaceCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_sha256",
        "face_index",
        "barycentric"
      ],
      "properties": {
        "topology_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "face_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36107
        },
        "barycentric": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "surfaceCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinates",
        "rest_surface_arc_length_m",
        "width_m",
        "deposition",
        "direction",
        "source_primitive_sha256",
        "compiler_sha256"
      ],
      "properties": {
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/surfaceCoordinate"
          },
          "minItems": 2
        },
        "rest_surface_arc_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deposition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "direction": {
          "enum": [
            "forward",
            "reverse"
          ]
        },
        "source_primitive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compiler_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "inkState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ink_id",
        "load_fraction"
      ],
      "properties": {
        "ink_id": {
          "type": "string",
          "minLength": 1
        },
        "load_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
