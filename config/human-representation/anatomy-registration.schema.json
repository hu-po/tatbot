{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/anatomy-registration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "source",
    "version",
    "license",
    "structure_ids",
    "atlas_from_body",
    "warp",
    "error_m",
    "confidence",
    "population_limitations",
    "validation_set_sha256",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.anatomy-registration/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "structure_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "atlas_from_body": {
      "$ref": "common.schema.json#/$defs/matrix4"
    },
    "warp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "definition_sha256",
            "max_error_m"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "definition_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "max_error_m": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "error_m": {
      "type": "number",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "population_limitations": {
      "type": "string",
      "minLength": 1
    },
    "validation_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
