{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/anatomy-source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "use_case",
    "source",
    "version",
    "pack_license_spdx",
    "objects",
    "separate_asset_root",
    "code_license_spdx",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "tatbot.anatomy-source-manifest/1"},
    "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "use_case": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "pack_license_spdx": {"type": "string", "minLength": 1},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_object_id",
          "source_uri",
          "sha256",
          "license_spdx",
          "attribution",
          "derivatives_permitted",
          "object_license_verified",
          "downloaded"
        ],
        "properties": {
          "source_object_id": {"type": "string", "minLength": 1},
          "source_uri": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "license_spdx": {"type": "string", "minLength": 1},
          "attribution": {"type": "string", "minLength": 1},
          "derivatives_permitted": {"type": "boolean"},
          "object_license_verified": {"type": "boolean"},
          "downloaded": {"type": "boolean"}
        }
      }
    },
    "separate_asset_root": {"type": "string", "minLength": 1},
    "code_license_spdx": {"const": "Apache-2.0"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
  }
}
