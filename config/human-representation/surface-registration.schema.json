{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/surface-registration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "source_frame",
    "target_frame",
    "body_state_sha256",
    "measured_surface_sha256",
    "method",
    "correspondences",
    "observed_patch_from_body",
    "supported_cells",
    "covariance",
    "confidence",
    "capture_sha256",
    "calibration_sha256",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.surface-registration/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_frame": {
      "const": "body"
    },
    "target_frame": {
      "const": "observed_patch"
    },
    "body_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measured_surface_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "correspondences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical",
          "observed_xyz_m",
          "error_m"
        ],
        "properties": {
          "canonical": {
            "$ref": "common.schema.json#/$defs/surfaceCoordinate"
          },
          "observed_xyz_m": {
            "$ref": "common.schema.json#/$defs/vec3"
          },
          "error_m": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "minItems": 1
    },
    "observed_patch_from_body": {
      "$ref": "common.schema.json#/$defs/matrix4"
    },
    "supported_cells": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1
    },
    "covariance": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 36,
      "maxItems": 36
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
