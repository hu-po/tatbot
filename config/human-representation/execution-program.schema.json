{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/execution-program.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "ink_program",
    "body_state",
    "surface_registration",
    "measured_surface",
    "tool",
    "robot",
    "support",
    "palette",
    "calibration",
    "exact_events",
    "uncertainty",
    "preflight",
    "samples_manifest",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.execution-program/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ink_program": {
      "$ref": "ink-program.schema.json"
    },
    "body_state": {
      "$ref": "body-state.schema.json"
    },
    "surface_registration": {
      "$ref": "surface-registration.schema.json"
    },
    "measured_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "tatbot.surface/1"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "datasheet_sha256",
        "class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "datasheet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "urdf_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "urdf_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "configuration_sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256",
        "load_state_sha256",
        "resolved_caps"
      ],
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "load_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resolved_caps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ink_id",
              "slot",
              "robot_base_from_cap"
            ],
            "properties": {
              "ink_id": {
                "type": "string",
                "minLength": 1
              },
              "slot": {
                "type": "integer",
                "minimum": 0
              },
              "robot_base_from_cap": {
                "$ref": "common.schema.json#/$defs/matrix4"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "captured_utc"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "exact_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ink_event_index",
          "kind",
          "sample_range"
        ],
        "properties": {
          "ink_event_index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "const": "stroke"
          },
          "sample_range": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "minItems": 1
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_sigma_m",
        "surface_sigma_m"
      ],
      "properties": {
        "registration_sigma_m": {
          "type": "number",
          "minimum": 0
        },
        "surface_sigma_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_cells_only",
        "max_surface_age_s",
        "policy_sha256"
      ],
      "properties": {
        "observed_cells_only": {
          "const": true
        },
        "max_surface_age_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "samples_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256",
        "sidecar_path",
        "sidecar_sha256"
      ],
      "properties": {
        "schema": {
          "const": "tatbot.draw-samples/1"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sidecar_path": {
          "type": "string",
          "minLength": 1
        },
        "sidecar_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
