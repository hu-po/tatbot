{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/human-representation/surface-coordinate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "topology_sha256",
    "face_index",
    "barycentric"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.surface-coordinate/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "topology_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "face_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36107
    },
    "barycentric": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
