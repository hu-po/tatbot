// The fleet bus router. scripts/fleet_service.sh starts zenohd with this file,
// listening on the bus-router node's rig address (`lan` in config/nodes.json)
// instead of the loopback below, and, when that node holds the fleet bus
// credential, admitting only its user (docs/fleet.md, bus authentication).
{
  mode: "router",
  listen: { endpoints: ["tcp/127.0.0.1:7447"] },
  scouting: { multicast: { enabled: false }, gossip: { enabled: false } },
  adminspace: { enabled: false }
}
