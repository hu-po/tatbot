{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/inkmap/art.schema.json",
  "title": "Inkmap source art",
  "description": "A design as an image: what Inkmap places on the body. The art pipeline separates it at the width chosen there (tatbot art separate --brief); DrawingBot V3 computes the strokes there, never here. art_px is the art's rectangle by the pipeline's rule (python/tatbot_art image.art_box).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "name",
    "image",
    "art_px",
    "source",
    "palette"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.inkmap-art/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "sha256",
        "width_px",
        "height_px",
        "data_base64"
      ],
      "properties": {
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width_px": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16384
        },
        "height_px": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16384
        },
        "data_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10666672,
          "description": "The image bytes, base64; at most 8 MB."
        }
      }
    },
    "art_px": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "[x, y, width, height] in image pixels from the top left."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "license",
        "attribution",
        "generation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "stock",
            "imported",
            "generated"
          ]
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "prompt",
                "model",
                "generator"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "generator": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "palette": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inks",
            "style"
          ],
          "description": "The art pipeline's hints: the inks the design was made for and its separation style.",
          "properties": {
            "inks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              }
            },
            "style": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
