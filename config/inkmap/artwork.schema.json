{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/inkmap/artwork.schema.json",
  "description": "Frozen acquired metric artwork. Validation checks the program and content identity without regenerating geometry from source bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "name",
    "source_sha256",
    "source",
    "conversion",
    "program"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.inkmap-artwork/2"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "license",
        "attribution",
        "generation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "stock",
            "imported",
            "generated",
            "fixture"
          ]
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "prompt",
                "model",
                "model_revision",
                "seed",
                "tracing"
              ],
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "model_revision": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "seed": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tracing": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "request_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "png_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "model",
                    "model_revision",
                    "width",
                    "height",
                    "steps",
                    "guidance"
                  ],
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "model_revision": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    },
                    "steps": {
                      "type": "number"
                    },
                    "guidance": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "generated"
              }
            }
          },
          "then": {
            "properties": {
              "generation": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "generation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "recipe_sha256",
        "chord_error_m"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "recipe_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "chord_error_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.0001
        }
      }
    },
    "program": {
      "$ref": "../human-representation/tattoo-program.schema.json"
    }
  }
}
