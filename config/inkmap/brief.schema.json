{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/inkmap/brief.schema.json",
  "title": "Inkmap tattoo brief",
  "description": "What the art pipeline takes from Inkmap: each placement's source art and the width to separate it at (tatbot art separate --brief). Rotation, mirror, anchor and site record where the design goes on the body; nothing here is a motion program or a robot pose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "name",
    "body",
    "art",
    "placements"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.inkmap-brief/1"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "body": {
      "$ref": "https://tatbot.ai/schemas/inkmap/placement/v7#/properties/body"
    },
    "art": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://tatbot.dev/schemas/inkmap/art.schema.json"
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "art_id",
          "width_mm",
          "height_mm",
          "rotation_rad",
          "mirror",
          "anchor",
          "site",
          "sentence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "art_id": {
            "type": "string",
            "minLength": 1
          },
          "width_mm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "The art rectangle's width to separate at, to 0.1 mm."
          },
          "height_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotation_rad": {
            "type": "number"
          },
          "mirror": {
            "type": "boolean"
          },
          "anchor": {
            "$ref": "https://tatbot.ai/schemas/inkmap/placement/v7#/properties/placements/items/properties/anchor"
          },
          "site": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://tatbot.ai/schemas/inkmap/placement/v7#/properties/placements/items/properties/site"
              }
            ]
          },
          "sentence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
