{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.dev/schemas/inkmap/project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content_sha256",
    "name",
    "placement_file",
    "editor",
    "history",
    "edit_before",
    "selected_id"
  ],
  "properties": {
    "schema": {
      "const": "tatbot.inkmap-project/5"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "placement_file": {
      "$ref": "https://tatbot.ai/schemas/inkmap/placement/v7"
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pose_id",
        "skin_tone",
        "show_atlas",
        "camera"
      ],
      "properties": {
        "pose_id": {
          "type": "string"
        },
        "skin_tone": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "show_atlas": {
          "type": "boolean"
        },
        "camera": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "position",
                "target",
                "fov"
              ],
              "properties": {
                "position": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  }
                },
                "target": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  }
                },
                "fov": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 100
                }
              }
            }
          ]
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "past",
        "future"
      ],
      "properties": {
        "past": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "allOf": [
              {
                "$ref": "https://tatbot.ai/schemas/inkmap/placement/v7#/properties/placements"
              },
              {
                "maxItems": 100
              }
            ]
          }
        },
        "future": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "allOf": [
              {
                "$ref": "https://tatbot.ai/schemas/inkmap/placement/v7#/properties/placements"
              },
              {
                "maxItems": 100
              }
            ]
          }
        }
      }
    },
    "edit_before": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "allOf": [
            {
              "$ref": "https://tatbot.ai/schemas/inkmap/placement/v7#/properties/placements"
            },
            {
              "maxItems": 100
            }
          ]
        }
      ]
    },
    "selected_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
