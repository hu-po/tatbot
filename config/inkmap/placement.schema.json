{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.ai/schemas/inkmap/placement/v6",
  "title": "Inkmap placement file",
  "description": "Placements on the reviewed MHR/SOMA surface with frozen shared artwork. v6 stores acquired metric geometry rather than SVG materialization inputs.",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "body",
    "placements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 6
    },
    "units": {
      "type": "object",
      "required": [
        "length",
        "tattoo_size",
        "up"
      ],
      "additionalProperties": false,
      "properties": {
        "length": {
          "const": "m"
        },
        "tattoo_size": {
          "const": "mm"
        },
        "up": {
          "const": "+z"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "model_spec_id",
        "model_spec_sha256",
        "identity_sha256",
        "topology_sha256",
        "rest_surface_sha256",
        "asset_path",
        "asset_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "model_spec_id": {
          "const": "mhr-soma-v1"
        },
        "model_spec_sha256": {
          "const": "e615b8485c367509833ee68b0405cd1e0ce6015604eaa4c1b2b699f4fc8d5144"
        },
        "identity_sha256": {
          "const": "800babcf48d09f4ff1da9d2e8a0ebe266869a19849557450c7210c9a9fb9a1b6"
        },
        "topology_sha256": {
          "const": "e0ca7ee25dc0b4c8d841bb2626e364bb88b7af7fae037e30854728842e320a18"
        },
        "rest_surface_sha256": {
          "const": "caa66dff9b3625771c8f4c35bfe59556d30acdc3800880106f98f0ce75c49a95",
          "description": "Digest of the canonical 18,056-vertex SOMA mid rest surface in Tatbot coordinates."
        },
        "asset_path": {
          "const": "bodies/mhr-soma-v1.glb"
        },
        "asset_sha256": {
          "const": "c1d0ec25c6f4708bb3e8d48811711da0d309598a6b85cf256975d49d1d46e841"
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "design_id",
          "anchor",
          "rotation_rad",
          "size_mm",
          "mirror"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "design_id": {
            "type": "string",
            "minLength": 1,
            "description": "Content-addressed vector design identifier. Generated designs are embedded in this file."
          },
          "anchor": {
            "type": "object",
            "required": [
              "face",
              "barycentric"
            ],
            "additionalProperties": false,
            "properties": {
              "face": {
                "type": "integer",
                "minimum": 0
              },
              "barycentric": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Weights of the design origin (SVG viewBox centre) on the face's three vertices; sum to 1."
              }
            }
          },
          "rotation_rad": {
            "type": "number",
            "description": "Rotation of the design about the surface normal, from the body-up direction projected onto the tangent plane."
          },
          "size_mm": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "description": "[width, height] of the design on the surface."
          },
          "mirror": {
            "type": "boolean"
          },
          "site": {
            "type": "object",
            "description": "The named InkLang site that owns this reviewed eligible SOMA anchor.",
            "required": [
              "id",
              "lexicon"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "laterality": {
                "enum": [
                  "left",
                  "right",
                  "center",
                  null
                ]
              },
              "aspect": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "enum": [
                  "upper",
                  "lower",
                  "mid",
                  null
                ]
              },
              "uv": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Chart coordinate inside the region (u proximal-to-distal, v medial-to-lateral)."
              },
              "lexicon": {
                "type": "string",
                "minLength": 1,
                "description": "inklang lexicon version the site id is valid in."
              }
            }
          },
          "language": {
            "type": "object",
            "description": "The language intent and exact surface-resolution provenance.",
            "required": [
              "sentence",
              "program"
            ],
            "additionalProperties": false,
            "properties": {
              "sentence": {
                "type": "string",
                "minLength": 1
              },
              "program": {
                "type": "object"
              },
              "intent": {
                "type": "object",
                "description": "Optional canonical InkLang intent that produced this placement."
              },
              "resolution": {
                "type": "object",
                "description": "Optional canonical InkLang resolution, including body/surface, anchor, and policy provenance."
              },
              "consumer_policy": {
                "type": "string",
                "minLength": 1,
                "description": "Optional named downstream policy that selected among canonical resolutions."
              }
            }
          }
        }
      }
    },
    "designs": {
      "type": "object",
      "description": "Shared frozen artwork records, keyed by the placement design ID.",
      "additionalProperties": {
        "$ref": "https://tatbot.dev/schemas/inkmap/artwork.schema.json"
      }
    }
  }
}
