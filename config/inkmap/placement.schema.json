{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatbot.ai/schemas/inkmap/placement/v3",
  "title": "Inkmap placement file",
  "description": "Tattoo placements on a 3D body. A placement is a surface anchor (face + barycentric on the body's skin geometry), a rotation about the surface normal, and a size in millimetres, referencing a vector design. The drawing frame is derived, never stored. v3 adds optional inklang site + language provenance per placement (additive; v1/v2 files load).",
  "type": "object",
  "required": [
    "schema_version",
    "units",
    "body",
    "placements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "units": {
      "type": "object",
      "required": [
        "length",
        "tattoo_size",
        "up"
      ],
      "additionalProperties": false,
      "properties": {
        "length": {
          "const": "m"
        },
        "tattoo_size": {
          "const": "mm"
        },
        "up": {
          "const": "+z"
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "id",
        "sha256",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the GLB bytes the anchors were made on. Face indices are only meaningful against this exact file and load recipe."
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "design_id",
          "anchor",
          "rotation_rad",
          "size_mm",
          "mirror"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "design_id": {
            "type": "string",
            "minLength": 1,
            "description": "Vector design (SVG) identifier from the design manifest."
          },
          "anchor": {
            "type": "object",
            "required": [
              "face",
              "barycentric"
            ],
            "additionalProperties": false,
            "properties": {
              "face": {
                "type": "integer",
                "minimum": 0
              },
              "barycentric": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Weights of the design origin (SVG viewBox centre) on the face's three vertices; sum to 1."
              }
            }
          },
          "rotation_rad": {
            "type": "number",
            "description": "Rotation of the design about the surface normal, from the body-up direction projected onto the tangent plane."
          },
          "size_mm": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "description": "[width, height] of the design on the surface."
          },
          "mirror": {
            "type": "boolean"
          },
          "site": {
            "type": "object",
            "description": "v3: the named inklang body site this placement was made against. The anchor stays the geometric truth; this records which named region it belongs to, so language and eval can refer to it. Site ids come from config/inkmap/sites.json at the given lexicon version.",
            "required": [
              "id",
              "lexicon"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "laterality": {
                "enum": ["left", "right", "center", null]
              },
              "aspect": {
                "type": ["string", "null"]
              },
              "level": {
                "enum": ["upper", "lower", "mid", null]
              },
              "uv": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "description": "Chart coordinate inside the region (u proximal-to-distal, v medial-to-lateral)."
              },
              "lexicon": {
                "type": "string",
                "minLength": 1,
                "description": "inklang lexicon version the site id is valid in."
              }
            }
          },
          "language": {
            "type": "object",
            "description": "v3: the tattoo program and its canonical realized sentence. The program is the source of truth (validated by the inklang core, not this schema); the sentence is always re-derivable from it.",
            "required": [
              "sentence",
              "program"
            ],
            "additionalProperties": false,
            "properties": {
              "sentence": {
                "type": "string",
                "minLength": 1
              },
              "program": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "designs": {
      "type": "object",
      "description": "v2: designs referenced by placements that are not files shipped with the app (e.g. generated in the session), keyed by design id, so the file stays self-contained.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "svg",
          "default_size_mm"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "svg": {
            "type": "string",
            "minLength": 5,
            "description": "The SVG document text."
          },
          "default_size_mm": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "generated"
              },
              "model": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "seed": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
