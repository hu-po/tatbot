<?xml version="1.0" ?>
<robot name="tatbot">
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
    <specular rgba="0.5 0.5 0.5 1"/>
  </material>
  <link name="root">
      <origin rpy="0 0 0" xyz="0 0 0"/>
  </link>

  <!-- palette -->
  <link name="palette_root">
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
