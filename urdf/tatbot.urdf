<?xml version="1.0" ?>
<robot name="tatbot">
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
    <specular rgba="0.5 0.5 0.5 1"/>
  </material>
  <link name="root">
      <origin rpy="0 0 0" xyz="0 0 0"/>
  </link>

  <!-- Robot-centric axes: +X forward through the fixed cameras, +Y toward
       the robot's left hand, +Z up. Left/right never mean the observer's
       left/right when looking back at the robot. Keep the aluminum frame
       centered between the arms; a misidentified calibration wrist must
       be corrected in the registration, not hidden by shifting the rig. -->
  <link name="rig_center"/>
  <joint name="rig_center_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="root"/>
    <child link="rig_center"/>
  </joint>

  <!-- Movable palette is a separate scene asset: palette.urdf. -->

  <!-- camera1 -->
  <joint name="camera1_mount_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.074 0 0.085"/>
    <parent link="rig_center"/>
    <child link="camera1"/>
  </joint>
  <link name="camera1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/cameras/amcrest.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/cameras/amcrest.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera1_frame_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0.07"/>
    <parent link="camera1"/>
    <child link="camera1_frame"/>
  </joint>
  <link name="camera1_frame"/>
  <joint name="camera1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 1.5707963267948966 -0.7853981633974483" xyz="0 0 0"/>
    <parent link="camera1_frame"/>
    <child link="camera1_optical_frame"/>
  </joint>
  <link name="camera1_optical_frame"/>
  
  <!-- camera2 -->
