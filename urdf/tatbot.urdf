        <mesh filename="meshes/frame/palette.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="palette_root_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.126 0 0.085"/>
