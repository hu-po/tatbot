      <geometry><mesh filename="meshes/ee/ee_pen_mount.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ee_print_black3"><color rgba="0.16 0.16 0.17 1"/></material>
    </visual>
  </link>
  <joint name="right/ee_mount_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="right/gripper_left"/>
    <child link="right/ee_mount"/>
  </joint>
  <!-- tool_mount: origin = centre of the bore face the tool leaves through (the
       x = 45 mm end of ee_pen_mount, away from the wall), +z = the tool axis
       toward the tip, +x = link z (the wrist-camera axis). In link_6 at
       carriage rest: (0.165, 0.067, 0), tip direction (+x, -y)/sqrt2. -->
  <link name="right/tool_mount"/>
  <joint name="right/tool_mount_joint" type="fixed">
