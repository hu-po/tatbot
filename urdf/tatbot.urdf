  <!-- right/gripper_left is a FRAME only since 2026-08-30: both fingertips are
       physically removed. It is kept because the wrist fiducials and the EE
       mount chain are parented to it (its origin is the carriage's 2x3 M3
       pattern centre; +x the pattern's normal). No geometry. -->
  <link name="right/gripper_left"/>
  <joint name="right/left_gripper_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="right/carriage_left"/>
    <child link="right/gripper_left"/>
  </joint>
  <!-- EE mount chain (2026-08-30, from the three printed-part STLs in urdf/meshes/ee/,
       mm-scaled):
       carriage front face (the 2x3 M3 pattern at 14 x 12 mm the finger bolts to,
       pattern centre = this link's origin, normal = +x)
         -> ee_fiducial_cube.stl: 6 mm plate on that pattern, plate x -> link +y
            (+7 mm), plate y -> link z, plate z -> link x; the 66 mm hollow cube
            with the wrist tags sits 75-141 mm out on the +y side (cube "up")
         -> ee_base.stl: 4 mm plate on the same pattern (rotated 180 deg on it),
            6 mm further out; its wall rises on the cube side (+y, 27-53 mm past
            the pattern) and ends in a 45 deg face
         -> ee_pen_mount.stl: on that face by four M3 (17.9 x 43.3 mm); the pen
            bore (dia 32, along the block's own x) is parallel to the face, so
            the tool axis is 45 deg between link -y and +x: in the rolled idle
            (cube up, x forward) the tip points forward-and-down, exiting the
            bore end away from the wall. The 2x3 pattern is symmetric, so the
            other 180 deg seat (wall across the centreline, tip down-and-back)
            is geometrically possible; the operator's "tilted forward" and the
            wrist's reach (a back-tilted tip cannot be held vertical, joint_3
            hits its limit) pick this one.
       Neither fingertip is fitted any more; the plates sit directly on the
       carriage's pattern. NOMINAL: the chain is exact to the STLs; only the
       carriage hole pattern's position in this link (+-0.5 mm) and the pen's
       seat in the bore are unmeasured. The touch-off measures the tip in
       tool_mount. -->
  <link name="right/ee_mount">
    <visual>
      <origin rpy="1.5707963 0 1.5707963" xyz="0 0.007 0"/>
      <geometry><mesh filename="meshes/ee/ee_fiducial_cube.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ee_print_black"><color rgba="0.12 0.12 0.13 1"/></material>
    </visual>
    <visual>
      <origin rpy="-1.5707963 0 -1.5707963" xyz="0.006 0.007 0"/>
      <geometry><mesh filename="meshes/ee/ee_base.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="ee_print_black2"><color rgba="0.14 0.14 0.15 1"/></material>
