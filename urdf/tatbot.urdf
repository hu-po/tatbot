  <!-- Installed left laser identity; mirrored V5 CAD visuals. The assembly
       meshes are in the CAD frame (left/carriage_right, millimetres), but the
       print is bolted to the OTHER carriage, rolled 180 degrees about the
       carriage x axis (the 2x3 M3 pattern is symmetric under that roll), so
       the V5 sits under left/carriage_left at rpy="pi 0 0". Evidence: the
       measured wrist_left tags (config/wrist_tags_measured_left.json) lie on
       the carrier's three faces only in that placement, and the pen axis
       then points straight down in every 2026-09-16 palette contact hold
       (sweep-arm-blue-20260916_132711). Legacy handle/finger links above
       retain frames only. Both D405 chains remain on their own wrists.
       The compact rear-facing carrier replaces the V5 carrier.
       See meshes/ee/fiducial-cubes-47mm-rear/provenance.json. -->
  <link name="left/ee_mount">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="meshes/ee/leader-laser-v5/01_leader_cradle.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="laser_01_leader_cradle"><color rgba="0.12 0.12 0.13 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="meshes/ee/leader-laser-v5/02_oval_clamp_cap.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="laser_02_oval_clamp_cap"><color rgba="0.12 0.12 0.13 1"/></material>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="meshes/ee/fiducial-cubes-47mm-rear/left_fiducial_cube_47mm.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="laser_03_mirrored_tag_carrier"><color rgba="0.12 0.12 0.13 1"/></material>
    </visual>
  </link>
  <joint name="left/ee_mount_joint" type="fixed">
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
    <parent link="left/carriage_left"/>
    <child link="left/ee_mount"/>
  </joint>
  <!-- leader-laser-v5 tool_mount: the fat end of the 35 mm oval grip cavity, the
       CAD clamp datum, +z along the pen axis toward the nose, +x along the
       carriage -z. This is the CAD datum (provenance tool_datum) carried
       through the installed placement above: Rx(pi) applied to the CAD
       origin and axes, so +z is carriage +x-y — the same direction in link 6
       as the follower's datum. The 2026-09-16 touch-off in this frame lives
       in config/workspace.yaml (re-expressed from the pre-correction frame
       on 2026-09-17; the tip in link 6 is unchanged). The pen itself is the
       generated tool block from its datasheet. -->
  <link name="left/tool_mount"/>
  <joint name="left/tool_mount_joint" type="fixed">
    <origin rpy="0.785398163397448 1.570796326794897 0" xyz="0.038110806929 0.065907191271 0.000564"/>
    <parent link="left/carriage_left"/>
    <child link="left/tool_mount"/>
  </joint>
  <joint name="left/ee_gripper" type="fixed">
    <origin rpy="0 0 0" xyz="0.156062 0 0"/>
    <parent link="left/link_6"/>
    <child link="left/ee_gripper_link"/>
  </joint>
  <link name="left/ee_gripper_link"/>


