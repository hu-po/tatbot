#!/usr/bin/env bash
# tatbot pre-push: the public export gate, and nothing that costs minutes.
#
# Armed with the rest of scripts/githooks (scripts/check --install-hooks).
# Bypass in an emergency:  git push --no-verify
#
# No heavy suite runs here: main advances every few minutes, several agents push
# near each other, and a ten-minute gate multiplies by all of them. CI runs the
# full suite for every origin/main; run `scripts/check sim2 sim2-gpu` yourself
# when you touch the simulator.

set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# The gate below is for main. A push to an agent branch (agent/<node>/<session>,
# made by the post-commit hook after every commit) carries no promise about the
# public export and must stay free, or "push every commit" costs 11 s each.
to_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [[ "$remote_ref" == refs/heads/main ]] && to_main=1
done
((to_main)) || exit 0
# The public export gate costs 11 seconds and is the only check that catches a
# stale substitution rule or an unmatched manifest path. A red CI nobody reads
# prevents nothing: run it here so the author who breaks it is the one who is
# told, and `tatbot release` finds main publishable.
#
# It can fail on breakage someone else pushed; that is the point. The gate names
# the rule or path, `scripts/check export` reproduces it, and whoever pushes next
# fixes it instead of it sitting red for hours.
if ! "$ROOT/scripts/check" --no-hooks export; then
  echo "pre-push: the public export gate failed -- reproduce with 'scripts/check export'." >&2
  echo "pre-push: if it is not your change, main is already broken; fixing it unblocks everyone." >&2
  exit 1
fi

exit 0
