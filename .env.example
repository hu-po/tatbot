# Copy to the git-ignored .env beside this file.
# https://huggingface.co/settings/tokens
# `tatbot data hub`, `tatbot record`, `tatbot inkmap deploy` and
# `tatbot inkgen deploy` read these: a fine-grained token with repo write on
# the tatbot org and your user namespace, and the namespace datasets land in.
export HF_TOKEN="your_huggingface_token_here"
export HF_USER="your_huggingface_username"

# Camera credentials do not go here: they live in ~/.config/tatbot/cameras.env
# as TATBOT_CAMERA_PASSWORD_CAMERA1..5, the password_env names in
# rust/visiond/config/vision.toml.
