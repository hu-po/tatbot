# Copy to the git-ignored .env beside this file.
# https://huggingface.co/settings/tokens
# `tatbot data hub`, `tatbot record`, `tatbot inkmap deploy` and
# `tatbot inkgen deploy` read these: a fine-grained token with repo write on
# the tatbot org and your user namespace, and the namespace datasets land in.
export HF_TOKEN="your_huggingface_token_here"
export HF_USER="your_huggingface_username"

# Image generation: Inkgen is the default and needs no paid-provider key.
# Optional local default: inkgen | fal | gemini | openai.
# The backend reads this file's private .env copy; process variables win.
# Hosted visitors always start with Inkgen and supply their own cloud key.
INKGEN_PROVIDER=inkgen
FAL_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
